	  <exercise label="geometry-transformation_5">
			<statement>
					<p>
					  What is the geometric effect on the plane <m>z=1</m> given by the transformation with matrix

					  <md>
					    \left[ \begin{array}{rrr}0 &amp; -1 &amp; 0 \\ 1 &amp; 0 &amp; 0 \\ 0 &amp; 0 &amp; 1\end{array} \right]
					  </md>?
					</p>

					<p>
					  Hint: calculate <m>A \left[ \begin{array}{c}x \\ y \\ 1\end{array} \right]</m>.
					</p>
			</statement>
			<choices randomize="no">
				<choice>
					<statement>
						<p>
							Translates one unit to the left and one unit up.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Reflects across the <m>y</m>-axis.
						</p>
					</statement>
				</choice>
				<choice correct="yes">
					<statement>
						<p>
							Rotates 90 degrees counterclockwise.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							None of the other choices is correct.
						</p>
					</statement>
				</choice>
			</choices>
		</exercise>

