	  <exercise label="geometry-transformation_7">
			<statement>
				<p>
					Which of the following matrices corresponds to the transformation of the plane <m>z=1</m> that has the geometric
					effect of stretching horizontally by 2 and moving down 2?
				</p>

				<p>
					Hint: calculate <m>A \left[ \begin{array}{c}x \\ y \\ 1\end{array} \right]</m>.
				</p>
			</statement>
			<choices>
				<choice>
					<statement>
						<p>
							 <m>
							   \left[ \begin{array}{rrr}2 &amp; 0 &amp; 0 \\ 0 &amp; 1 &amp; -2 \\ 0 &amp; 0 &amp; 1\end{array} \right]
							 </m>
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							 <m>
							   \left[ \begin{array}{rrr}2 &amp; 0 &amp; -2 \\ 0 &amp; 1 &amp; 0 \\ 0 &amp; 0 &amp; 1\end{array} \right]
							 </m>
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							<m>
							   \left[ \begin{array}{rrr}1 &amp; 0 &amp; -2 \\ 0 &amp; 2 &amp; 0 \\ 0 &amp; 0 &amp; 1\end{array} \right]
							 </m>
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							 <m>
							   \left[ \begin{array}{rrr}1 &amp; 0 &amp; 0 \\ 0 &amp; 2 &amp; -2 \\ 0 &amp; 0 &amp; 1\end{array} \right]
							 </m>
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							None of the other choices is correct.
						</p>
					</statement>
				</choice>
			</choices>
		</exercise>

	  <exercise label="geometry-transformation_8">
			<statement>
					<p>
					  Consider the transformation of the plane <m>z=1</m> given by the matrix
					  <md>
					    \left[ \begin{array}{rrr}-1 &amp; 0 &amp; 1 \\ 0 &amp; -1 &amp; 0 \\ 0 &amp; 0 &amp; 1\end{array} \right]
					  </md>.
					</p>

					<p>
					  Suppose we have a stick figure standing at the point <m>(0,0,1)</m>.
					  Which is a correct description of the stick figure after we apply the transformation?
					  Select all correct answers.
					</p>

					<p>
					  Hint: calculate <m>A \left[ \begin{array}{c}x \\ y \\ 1\end{array} \right]</m>.
					</p>
			</statement>
			<choices>
				<choice correct="yes">
					<statement>
						<p>
							The stick figure will be standing at the point <m>(1,0,1)</m>.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							The stick figure will be standing at the point <m>(0,1,1)</m>.
						</p>
					</statement>
				</choice>
				<choice correct="yes">
					<statement>
						<p>
							The stick figure will be standing on its head.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							The stick figure will be laying down.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							The stick figure will be standing at the point <m>(-1,-1,0)</m>.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							The stick figure will be twice as tall.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							The stick figure will be twice as wide.
						</p>
					</statement>
				</choice>
			
			</choices>
		</exercise>
    
