<!-- Non-WW enabled Problems from this edfinity section -->
	  <exercise label="geometry-tranformation_1">
			<statement>
				<p>
					Which of the following transformations has the property that
					<m>T(\vec{e}_{1}) = \vec{e}_{1}</m>? Select all correct answers.
				</p>
			</statement>
			<choices randomize="yes">
				<choice correct="yes">
					<statement>
						<p>
							Reflection across the <m>x</m>-axis.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Reflection across the <m>y</m>-axis.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Reflection across the line <m>y = x</m>.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Rotation by 45 degrees counterclockwise.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Rotation by 90 degrees counterclockwise.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Rotation by 180 degrees counterclockwise.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Horizontal stretch by 2.
						</p>
					</statement>
				</choice>
				<choice correct="yes">
					<statement>
						<p>
							Vertical stretch by 2.
						</p>
					</statement>
				</choice>
				<choice>
					<statement>
						<p>
							Dilation by 3.
						</p>
					</statement>
				</choice>
				<choice correct="yes">
					<statement>
						<p>
							Projection onto the <m>x</m>-axis.
						</p>
					</statement>
				</choice>
			</choices>
		</exercise>

