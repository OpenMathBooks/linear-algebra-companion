## DESCRIPTION
## Matrix Algebra
## ENDDESCRIPTION

## Tagged by tda2d

## DBsubject(Linear algebra)
## DBchapter(Matrices)
## DBsection(Inverses)
## Institution(ASU)
## MLT(2x2generic)
## Level(2)
## TitleText1('Linear Algebra with Applications')
## AuthorText1('Jeffrey Holt')
## EditionText1('1')
## Section1('3.3')
## Problem1('')
## KEYWORDS('Algebra' 'Matrix' 'Matrices' 'Inverse')
DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGasu.pl",
  "PGchoicemacros.pl",
  "PGmatrixmacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$a = non_zero_random(-9,9,2);
$b = non_zero_random(-8,8,2);
$c = non_zero_random(-9,9,1);
do {$d = random(-9,9,2);} until (($a * $d - $b * $c) != 0);

$det = $a * $d - $b * $c;

$ans11 = $d / $det;
$ans12 = - $b / $det;
$ans21 = - $c / $det;
$ans22 = $a / $det ;

BEGIN_TEXT
On this problem, you may use SAGE to check, but first compute by hand.
$PAR
$HR

Use the fact that 
\( \left[ \begin{array}{cc} a & b \\ c & d \end{array} \right]^{-1}
= \displaystyle \frac{1}{ad-bc}\left[ \begin{array}{rr} d & -b \\ -c & a \end{array} \right]\)
, assuming \(ad-bc \neq 0\).
$HR

If
\( A = \{ display_matrix_mm([[$a, $b],[$c,$d]], align=>'rr') \}
\),
then its inverse is

$BCENTER
 \{ mbox('\(A^{-1} =\)',
display_matrix([[ans_rule(8),ans_rule(8)],
[ans_rule(8),ans_rule(8)]], 'align'=>"cc"))
\}
$ECENTER


END_TEXT

ANS(num_cmp($ans11));
ANS(num_cmp($ans12));
ANS(num_cmp($ans21));
ANS(num_cmp($ans22));



ENDDOCUMENT();       # This should be the last executable line in the problem.