## DESCRIPTION
## Systems of Linear Equations
## ENDDESCRIPTION

## Tagged by tda2d

## DBsubject(Linear algebra)
## DBchapter(Systems of linear equations)
## DBsection(Augmented matrices)
## Institution(ASU)
## MLT(augmat)
## MLTleader(1)
## Level(2)
## KEYWORDS('Algebra' 'Linear Equations' 'Matrix' 'Matrices')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "PGasu.pl",
  "PGchoicemacros.pl",
  "PGmatrixmacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$a1 = non_zero_random(0,9,1);
$b1 = non_zero_random(0,9,1);
$d1 = 0;
$a2 = non_zero_random(0,9,1);
$b2 = non_zero_random(0,9,1);
$d2 = 0;
$a3 = non_zero_random(0,9,1);
$b3 = non_zero_random(0,9,1);
$d3 = 0;
$a4 = random(-9,9,1);
$b4 = non_zero_random(0,9,1);
$c4 = non_zero_random(0,9,1);
$d4 = 0;
$a5 = non_zero_random(0,9,1);
$b5 = non_zero_random(0,9,1);
$d5 = 0;

@a = ($a1, $a2, $a3, $a4, $a5);
@b = ($b1, $b2, $b3, $b4, $b5);
@d = ($d1, $d2, $d3, $d4, $d5);

@mx = ("$a1 x_1", "$a2 x_1", "$a3 x_1", "$a4 x_1", "$a5 x_1");
@my = ("+$b1 x_2", "+$b2 x_2", "+$b3 x_2", "+$b4 x_2", "+$b5 x_2");
@m = ("$d1", "$d2", "$d3", "$d4", "$d5");

$tag1 = random(0,2,1);
 
$NO_SPACE = '@{}';

BEGIN_TEXT

Write the augmented matrix of the system
\[  \begin{array}{r${NO_SPACE}r${NO_SPACE}r${NO_SPACE}r${NO_SPACE}r}
\{join("&",$mx[$tag1],$my[$tag1],$mz[$tag1],"=",$m[$tag1] ) \} \cr
\end{array}  \]

$BR

$BCENTER
\{display_matrix([
[ans_rule(5),ans_rule(5),ans_rule(5)]],
  'align' =>"cc|c")
\}
$ECENTER

$PAR
(Yes, there is only one equation in the system.)
$PAR


END_TEXT

ANS(num_cmp($a[$tag1], mode=>"arith"));
ANS(num_cmp($b[$tag1], mode=>"arith"));
ANS(num_cmp($d[$tag1], mode=>"arith"));




ENDDOCUMENT();       # This should be the last executable line in the problem.