## Problem1('')
## KEYWORDS('linear algebra','matrix','multiplication')

DOCUMENT();
loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserPopUp.pl",
  "PGML.pl",
  "AnswerFormatHelp.pl",
  "PGcourse.pl"
);
$showPartialCorrectAnswers = 0;
TEXT(beginproblem()); 

Context('Matrix');

$A = Matrix([
[non_zero_random(-5,5,1),non_zero_random(-5,5,1)],
[non_zero_random(-5,5,1),non_zero_random(-5,5,1)],
]);

$B = Matrix([
[non_zero_random(-5,5,1),non_zero_random(-5,5,1),non_zero_random(-5,5,1)],
[non_zero_random(-5,5,1),non_zero_random(-5,5,1),non_zero_random(-5,5,1)],
]);

$ans1 = $A * $B;
$ans2 = 'DNE';
$popup = PopUp(['Choose','True','False'],'False');

BEGIN_PGML

Let
>> [`` A = [$A]``] and [`` B = [$B]``]. <<

If possible, compute the following.
If an answer does not exist, enter DNE.


[`AB = `] [_________________________]{$ans1}


[`BA = `] [__________________________]{$ans2}


[@ AnswerFormatHelp("matrices") @]*


[_]{$popup} True or False: For any two matrices 
[`A`] and [`B`], both of the products [`AB`] and [`BA`] 
are always defined.
END_PGML




ENDDOCUMENT();