    <!-- Exercises from 1.2b - Edfinity ALL CURRENTLY MULTIPLE CHOICE/SELECT non_WW problems-->
    <exercise label="row-ops-mc-1">
      <statement>
        <p>
          <p>
            Consider the matrix <m>\left[ \begin{array}{rr|r}2 \amp 1 \amp 0 \\ 0 \amp 3 \amp -1\end{array} \right]</m>.
            In the standard row-reduction algorithm, the first step is to perform a row operation to make the
            <m>(1,1)</m>-entry equal to 1.
            Which row operation accomplishes that?
          </p>

          <p>
            Note: the <m>(1,1)</m>-entry means the entry in row 1, column 1.
          </p>
        </p>
      </statement>

      <choices randomize="yes">
        <choice correct="yes">
          <statement>
            <p>
              new R1 = <m>
                \frac{1}{2}
              </m> R1
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = 2R1
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = R1 - 2R2
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = R1 +2R2
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>

    <exercise label="row-ops-mc-2">
      <statement>
        <p>
          <p>
            Consider the matrix <m>\left[ \begin{array}{rr|r}1 \amp 3 \amp 5 \\ 2 \amp 4 \amp 6\end{array} \right]</m>.
            In the standard row-reduction algorithm, the next step is to perform a row operation to make the
            <m>(2,1)</m>-entry equal to 0.
            Which row operation accomplishes that?
          </p>

          <p>
            Note: the <m>(2,1)</m>-entry means the entry in row 2, column 1.
          </p>
        </p>
      </statement>

      <choices randomize="yes">
        <choice>
          <statement>
            <p>
              new R2 = <m>\frac{1}{2}</m> R2.
            </p>
          </statement>
        </choice>

        <choice correct="yes">
          <statement>
            <p>
              new R2 = R2 - 2R1.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R2 = R1 - 2R2.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              R1 <m>\leftrightarrow</m> R2.
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>

    <exercise label="row-ops-mc-3">
      <statement>
        <p>
          <p>
            Consider the matrix
            <m>\left[ \begin{array}{rrr|r}1 \amp 2 \amp 0 \amp 1 \\ 0 \amp 1 \amp 3 \amp 2 \\ 0 \amp 4 \amp 1 \amp 3\end{array} \right]</m>.
          </p>

          <p>
            In the standard row-reduction algorithm, the next step is to make the <m>(3,2)</m>-entry equal to 0 while
            not changing the first column.
            Which row operation accomplishes that?
          </p>

          <p>
            Note: the <m>(3,2)</m>-entry is the entry in the 3rd row and 2nd column.
          </p>
        </p>
      </statement>

      <choices randomize="yes">
        <choice correct="yes">
          <statement>
            <p>
              new R3 = R3 - 4R2.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R3 = R3 - 2R1.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R2 = 4R2-R3.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = 2R1 - R3.
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>

    <exercise label="row-ops-mc-4">
      <statement>
        <p>
          <p>
            We want to perform row operations that will take the matrix on the left to the matrix on the right
            <md>
              \left[ \begin{array}{rrrr|r}1 \amp 2 \amp 3\amp 4 \amp 5 \\ 0 \amp 1 \amp 6 \amp 7 \amp 8 \\ 0 \amp 0 \amp 1 \amp 9 \amp 10\end{array} \right] \longrightarrow \left[ \begin{array}{rrr r|r}1 \amp 2 \amp 0 \amp * \amp * \\ 0 \amp 1 \amp 0 \amp * \amp * \\ 0 \amp 0 \amp 1 \amp 9 \amp 10\end{array} \right]
            </md>
          </p>

          <p>
            What are those two row operations?
          </p>
        </p>
      </statement>

      <choices randomize="yes">
        <choice correct="yes">
          <statement>
            <p>
              new R1 = R1 - 3R3 and new R2 = R2 - 6R3.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = R1 - 3R3 and new R2 = R2 - 2R1.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = <m>\frac{1}{3}</m> R1 and new R2 = <m>\frac{1}{6}</m> R2.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = R1 - <m>\frac{1}{2}</m> R2 and new R2 = R2 - 6R3.
            </p>
          </statement>
        </choice>

        <choice>
          <statement>
            <p>
              new R1 = R1 - <m>\frac{1}{2}</m> R2 and new R2 = R2 - 2R1.
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>

    <exercise label="row-ops-mc 5">
      <statement>
        <p>
          We are many steps into the row reduction algorithm on a large matrix.
          The first four columns are in their final state for the RREF.
          There is a leading 1 in the <m>(3,5)</m>-entry of our matrix and that is what we want
          for the RREF.
          Unfortunately, the <m>(4,5)</m>-entry is not 0.
          We are looking for a row operation that will give us an equivalent matrix with 0 in the
          <m>(4,5)</m>-entry without messing up anything that's already what we want.
          (That means no changing the first four columns, and no changing the leading 1 in the
          <m>(3,5)</m>-entry of our matrix.) Which of the following statements are true about
          the row operation we should use?
          Choose all correct choices.
        </p>
      </statement>
      <choices multiple-correct="yes" randomize="yes">
        <choice>
          <statement>
            <p>
              It will replace R3 by something.
            </p>
          </statement>
        </choice>
        <choice correct="yes">
          <statement>
            <p>
              It will replace R4 by something.
            </p>
          </statement>
        </choice>
        <choice correct="yes">
          <statement>
            <p>
              It will add or subtract a multiple of R3.
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              It will add or subtract a multiple of R4.
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              It will multiply or divide the row by a nonzero constant.
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              It might involve R1 or R2 -- we don't have enough information to decide.
            </p>
          </statement>
        </choice>
        <choice correct="yes">
          <statement>
            <p>
              It will only involve R3 and R4.
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>

